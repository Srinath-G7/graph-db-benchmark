# Copy this file to .env and fill in real values. Never commit .env itself.

# --- CognoDB Cloud (Bolt / Cypher, Neo4j-compatible driver) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free (Bolt / Cypher) ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Memgraph (Bolt / Cypher, self-hosted via docker-compose) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- ArangoDB (AQL, self-hosted via docker-compose) ---
ARANGO_URL=http://localhost:8529
ARANGO_DB=benchmark
ARANGO_USER=root
ARANGO_PASSWORD=

# --- JanusGraph (Gremlin, self-hosted via docker-compose) ---
JANUSGRAPH_URL=ws://localhost:8182/gremlin

# --- Benchmark client settings ---
DATASET_PATH=./data/edges.csv
SAMPLE_START_NODES=200
READ_ITERATIONS=100
CONCURRENCY_LEVELS=10,40
MIXED_WORKLOAD_DURATION_SEC=30
